{
  "productName": "Speed4Trading",
  "version": "1.0.0",
  "private": true,
  "description": "MK attendance module",
  "author": "MK",
  "main": "main.cjs",
  "scripts": {
    "pack": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "mk.attendance",
    "productName": "Speed4Trading",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "isapi.cjs",
      "hik-connect.cjs",
      "dist/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "Speed4Trading-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
