{
  "name": "zubayd-desktop",
  "version": "1.2.1",
  "description": "Speed for Training - attendance and Hikvision access control",
  "author": "Speed for Training",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "com.zubayd.accesscontrol",
    "productName": "Speed for Training",
    "copyright": "ط²ط¨ظٹط¯",
    "directories": {
      "output": "../releases/windows",
      "buildResources": "resources"
    },
    "files": [
      "*.cjs",
      "*.js",
      "*.html",
      "package.json",
      "!node_modules/**",
      "resources/brand.json",
      "resources/app.ico"
    ],
    "extraResources": [
      {
        "from": "../dist-server",
        "to": "server",
        "filter": [
          "**/*",
          "!.env*",
          "!**/*.bak",
          "!**/state*.json",
          "!**/credential-*.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SpeedForTraining-Setup-${version}.${ext}",
      "icon": "resources/app.ico",
      "signtoolOptions": {
        "publisherName": "MK",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Speed for Training",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "artifactName": "SpeedForTraining-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  }
}