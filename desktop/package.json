{
  "name": "speed4trading",
  "productName": "Speed4Trading",
  "version": "1.0.0",
  "private": true,
  "description": "Speed4Trading attendance",
  "author": "MK",
  "main": "main.cjs",
  "scripts": {
    "pack": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.speed4trading.attendance",
    "productName": "Speed4Trading",
    "directories": { "output": "release" },
    "files": ["main.cjs", "dist/**/*"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "Speed4Trading-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
